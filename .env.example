# Application
PORT=3000
NODE_ENV=production
CHECK_INTERVAL_SECONDS=30
TIMEZONE=Europe/Copenhagen
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
MONITOR_FAILURE_ALERT_THRESHOLD=3
MONITOR_SEND_RECOVERY_ALERT=true
REQUEST_TIMEOUT_MS=20000
REQUEST_RETRY_ATTEMPTS=3
HEALTH_MAX_CHECK_AGE_SECONDS=90
GIT_COMMIT_SHA=
LOG_LEVEL=info

# Telegram (PRIMARY)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SECONDARY)
# Host must be a DNS hostname only: no quotes, spaces, scheme, or :port.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_TLS_SERVERNAME=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=alerts@moderavia.com
EMAIL_FROM_NAME=Moderavia Monitoring
EMAIL_REPLY_TO=alerts@moderavia.com
EMAIL_SIGNATURE_NAME=Fayyad Mahmoud
EMAIL_SIGNATURE_COMPANY=Moderavia
EMAIL_SIGNATURE_DOMAIN=moderavia.com
ALERT_EMAIL=

# Protected POST /test-notifications
TEST_NOTIFICATION_TOKEN=

# TLS must stay enabled in production
TLS_REJECT_UNAUTHORIZED=true
PLAYWRIGHT_FALLBACK=true

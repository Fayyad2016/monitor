{
  "name": "monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Generic website monitoring platform with Findbolig as the first monitor",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "live:extract": "tsx scripts/live-extract.ts",
    "verify:runtime": "tsx scripts/verify-runtime.ts"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.2",
    "luxon": "^3.7.2",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.35.0",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
